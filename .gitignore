# Datos del SAE: tienen información personal (teléfonos, nombres, DNI). Nunca subirlos.
fuentes/*.csv
*.csv.bak

# Informes generados, controles y modelos en PDF (datos operativos)
informes/
modelos/*.pdf

# HTML intermedio del generador (lleva las coordenadas de los positivos)
plantillas/_*.html

# Dependencias y caché (se reinstalan con instalar.bat)
scripts/node_modules/
.cache_navegador/
__pycache__/
*.pyc

# Datos del tablero interactivo (se generan desde el CSV)
tablero/datos.js

# Hechos ubicados a mano: IDs del SAE con direcciones (datos operativos, como los CSV)
catalogo/ubicaciones_manuales.json

# Calles de OpenStreetMap (14 MB, se vuelven a descargar de Overpass)
fuentes/calles_osm_cordoba.json
